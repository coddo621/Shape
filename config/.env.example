# Flask Configuration
# Generate a secure key: python3 -c "import secrets; print(secrets.token_hex(32))"
# For production, set FLASK_SECRET_KEY via your platform's secret management (Heroku, AWS, etc.)
FLASK_SECRET_KEY=your_secret_key_here_generate_one
FLASK_ENV=development
FLASK_DEBUG=False

# Database
DATABASE_URL=sqlite:///instance/users.db
DATABASE_FILE=instance/users.db
INSTANCE_DIR=instance

# CORS - update for production
CORS_ORIGINS=http://localhost:5173

# Server
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False

# Session
PERMANENT_SESSION_LIFETIME_HOURS=1
SESSION_COOKIE_NAME=shap_sesh
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
